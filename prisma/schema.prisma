generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMIN
  USUARIO
}

model Usuario {
  id             Int      @id @default(autoincrement())
  nombre         String
  email          String   @unique
  contrasenaHash String
  rol            Rol      @default(USUARIO)
  creadoEn       DateTime @default(now())
  categorias     Categoria[]
  transacciones Transaccion[]
  tiposCuenta    TipoCuenta[]

  @@map("usuarios")
}

enum TipoMovimiento {
  INGRESO
  GASTO
}

model Categoria {
  id        Int            @id @default(autoincrement())
  nombre    String
  tipo      TipoMovimiento
  usuarioId Int
  usuario   Usuario        @relation(fields: [usuarioId], references: [id])
  transacciones Transaccion[]

  @@map("categorias")
}

model Transaccion {
  id          Int            @id @default(autoincrement())
  tipo        TipoMovimiento
  monto       Decimal        @db.Decimal(12, 2)
  descripcion String?
  fecha       DateTime
  categoriaId Int
  categoria   Categoria      @relation(fields: [categoriaId], references: [id])
  usuarioId   Int
  usuario     Usuario        @relation(fields: [usuarioId], references: [id])
 
  @@map("transacciones")

}

 

  enum ComportamientoCuenta {
  NORMAL
  TARJETA_CREDITO
  DEUDA
}

model TipoCuenta {
  id             Int                   @id @default(autoincrement())
  nombre         String
  comportamiento ComportamientoCuenta
  archivado      Boolean               @default(false)

  usuarioId      Int
  usuario        Usuario               @relation(fields: [usuarioId], references: [id])

  @@map("tipos_cuenta")
}


