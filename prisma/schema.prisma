generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMIN
  USUARIO
}

model Usuario {
  id             Int      @id @default(autoincrement())
  nombre         String
  email          String   @unique
  contrasenaHash String
  rol            Rol      @default(USUARIO)
  creadoEn       DateTime @default(now())

  @@map("usuarios")
}