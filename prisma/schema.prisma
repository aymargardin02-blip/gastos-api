generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMIN
  USUARIO
}

model Usuario {
  id             Int      @id @default(autoincrement())
  nombre         String
  email          String   @unique
  contrasenaHash String
  rol            Rol      @default(USUARIO)
  creadoEn       DateTime @default(now())
  categorias     Categoria[]
  transacciones Transaccion[]
  tiposCuenta    TipoCuenta[]
  cuentas        Cuenta[]

  @@map("usuarios")
}

enum TipoMovimiento {
  INGRESO
  GASTO
  TRANSFERENCIA
}

model Categoria {
  id        Int            @id @default(autoincrement())
  nombre    String
  tipo      TipoMovimiento
  usuarioId Int
  usuario   Usuario        @relation(fields: [usuarioId], references: [id])
  transacciones Transaccion[]

  @@map("categorias")
}

model Transaccion {
  id          Int            @id @default(autoincrement())
  tipo        TipoMovimiento
  monto       Decimal        @db.Decimal(12, 2)
  descripcion String?
  fecha       DateTime
  categoriaId Int
  categoria   Categoria      @relation(fields: [categoriaId], references: [id])
  usuarioId   Int
  usuario     Usuario        @relation(fields: [usuarioId], references: [id])
  
  cuentaId        Int
  cuenta          Cuenta            @relation("cuentaOrigen", fields: [cuentaId], references: [id])

  cuentaDestinoId Int?
  cuentaDestino   Cuenta?           @relation("cuentaDestino", fields: [cuentaDestinoId], references: [id])

  componenteDeuda ComponenteDeuda?

  @@map("transacciones")

}

 

  enum ComportamientoCuenta {
  NORMAL
  TARJETA_CREDITO
  DEUDA
}

model TipoCuenta {
  id             Int                   @id @default(autoincrement())
  nombre         String
  comportamiento ComportamientoCuenta
  archivado      Boolean               @default(false)

  usuarioId      Int
  usuario        Usuario               @relation(fields: [usuarioId], references: [id])
  cuentas        Cuenta[]  

  @@map("tipos_cuenta")
}


model Cuenta {
  id             Int         @id @default(autoincrement())
  nombre         String
  archivada      Boolean     @default(false)

  // Solo si el comportamiento de su tipo es TARJETA_CREDITO
  limiteCredito  Decimal?    @db.Decimal(12, 2)
  diaCorte       Int?
  diaPago        Int?

  // Comunes a TARJETA_CREDITO y DEUDA
  tasaInteres    Decimal?    @db.Decimal(5, 2)
  tieneInteres   Boolean?

  // Solo si el comportamiento de su tipo es DEUDA
  montoOriginal  Decimal?    @db.Decimal(12, 2)

  cuentaPagoId   Int?
  cuentaPago     Cuenta?     @relation("pagoDe", fields: [cuentaPagoId], references: [id])
  pagadaPor      Cuenta[]    @relation("pagoDe")

  tipoCuentaId   Int
  tipoCuenta     TipoCuenta  @relation(fields: [tipoCuentaId], references: [id])

  usuarioId      Int
  usuario        Usuario     @relation(fields: [usuarioId], references: [id])
  
  transacciones           Transaccion[] @relation("cuentaOrigen")
  transferenciasRecibidas Transaccion[] @relation("cuentaDestino")

  @@map("cuentas")
}

enum ComponenteDeuda {
  CAPITAL
  INTERES

}