generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMIN
  USUARIO
}

model Usuario {
  id             Int      @id @default(autoincrement())
  nombre         String
  email          String   @unique
  contrasenaHash String
  rol            Rol      @default(USUARIO)
  creadoEn       DateTime @default(now())
  categorias     Categoria[]

  @@map("usuarios")
}

enum TipoMovimiento {
  INGRESO
  GASTO
}

model Categoria {
  id        Int            @id @default(autoincrement())
  nombre    String
  tipo      TipoMovimiento
  usuarioId Int
  usuario   Usuario        @relation(fields: [usuarioId], references: [id])

  @@map("categorias")
}