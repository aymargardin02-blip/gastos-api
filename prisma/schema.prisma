generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMIN
  USUARIO
}

model Usuario {
  id                    Int                    @id @default(autoincrement())
  nombre                String
  email                 String                 @unique
  contrasenaHash        String
  rol                   Rol                    @default(USUARIO)
  creadoEn              DateTime               @default(now())
  categorias            Categoria[]
  transacciones         Transaccion[]
  tiposCuenta           TipoCuenta[]
  cuentas               Cuenta[]
  consentimientos       Consentimiento[]
  perfilSocial          PerfilSocial?
  preferenciaPrivacidad PreferenciaPrivacidad?
  zonaHoraria           String                 @default("America/Panama")
  racha                 Racha?
  presupuestos          Presupuesto[]

  @@map("usuarios")
}

enum TipoMovimiento {
  INGRESO
  GASTO
  TRANSFERENCIA
}

model Categoria {
  id                 Int                 @id @default(autoincrement())
  nombre             String
  tipo               TipoMovimiento
  usuarioId          Int
  usuario            Usuario             @relation(fields: [usuarioId], references: [id])
  transacciones      Transaccion[]
  limitesPresupuesto LimitePresupuesto[]

  @@map("categorias")
}

model Transaccion {
  id           Int            @id @default(autoincrement())
  tipo         TipoMovimiento
  monto        Decimal        @db.Decimal(12, 2)
  descripcion  String?
  fecha        DateTime
  registradaEn DateTime?

  categoriaId Int?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  cuentaId Int
  cuenta   Cuenta @relation("cuentaOrigen", fields: [cuentaId], references: [id])

  cuentaDestinoId Int?
  cuentaDestino   Cuenta? @relation("cuentaDestino", fields: [cuentaDestinoId], references: [id])

  componenteDeuda ComponenteDeuda?

  @@map("transacciones")
}

enum ComportamientoCuenta {
  NORMAL
  TARJETA_CREDITO
  DEUDA
}

model TipoCuenta {
  id             Int                  @id @default(autoincrement())
  nombre         String
  comportamiento ComportamientoCuenta
  archivado      Boolean              @default(false)

  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  cuentas   Cuenta[]

  @@map("tipos_cuenta")
}

model Cuenta {
  id        Int     @id @default(autoincrement())
  nombre    String
  archivada Boolean @default(false)

  limiteCredito Decimal? @db.Decimal(12, 2)
  diaCorte      Int?
  diaPago       Int?

  tasaInteres  Decimal? @db.Decimal(5, 2)
  tieneInteres Boolean?

  montoOriginal Decimal? @db.Decimal(12, 2)

  cuentaPagoId Int?
  cuentaPago   Cuenta?  @relation("pagoDe", fields: [cuentaPagoId], references: [id])
  pagadaPor    Cuenta[] @relation("pagoDe")

  tipoCuentaId Int
  tipoCuenta   TipoCuenta @relation(fields: [tipoCuentaId], references: [id])

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  transacciones           Transaccion[] @relation("cuentaOrigen")
  transferenciasRecibidas Transaccion[] @relation("cuentaDestino")

  @@map("cuentas")
}

enum ComponenteDeuda {
  CAPITAL
  INTERES
}

enum TipoConsentimiento {
  TERMINOS
  PRIVACIDAD
}

model Consentimiento {
  id         Int                @id @default(autoincrement())
  usuarioId  Int
  usuario    Usuario            @relation(fields: [usuarioId], references: [id])
  tipo       TipoConsentimiento
  version    String
  aceptadoEn DateTime           @default(now())

  @@unique([usuarioId, tipo, version])
  @@index([usuarioId])
  @@map("consentimientos")
}

model PerfilSocial {
  id            Int      @id @default(autoincrement())
  usuarioId     Int      @unique
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nombreUsuario String   @unique @db.VarChar(15)
  descripcion   String?  @db.VarChar(160)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("perfiles_sociales")
}

model PreferenciaPrivacidad {
  id                Int      @id @default(autoincrement())
  usuarioId         Int      @unique
  usuario           Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  participarRanking Boolean  @default(true)
  mostrarRacha      Boolean  @default(true)
  perfilPublico     Boolean  @default(true)
  actualizadoEn     DateTime @updatedAt

  @@map("preferencias_privacidad")
}

model Racha {
  id                Int       @id @default(autoincrement())
  usuarioId         Int       @unique
  usuario           Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rachaActual       Int       @default(0)
  mejorRacha        Int       @default(0)
  ultimoDiaRegistro DateTime?
  actualizadoEn     DateTime  @updatedAt

  @@map("rachas")
}

enum TipoPresupuesto {
  MENSUAL
  QUINCENAL
}

model Presupuesto {
  id            Int                 @id @default(autoincrement())
  usuarioId     Int
  usuario       Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo          TipoPresupuesto
  activo        Boolean             @default(true)
  creadoEn      DateTime            @default(now())
  actualizadoEn DateTime            @updatedAt
  limites       LimitePresupuesto[]

  @@map("presupuestos")
}

model LimitePresupuesto {
  id            Int         @id @default(autoincrement())
  presupuestoId Int
  presupuesto   Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  categoriaId   Int
  categoria     Categoria   @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  limite        Decimal     @db.Decimal(12, 2)

  @@unique([presupuestoId, categoriaId])
  @@index([categoriaId])
  @@map("limites_presupuesto")
}
